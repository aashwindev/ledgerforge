{
  "name": "ledgerforge",
  "displayName": "LedgerForge",
  "description": "Editor-native coding agent whose loop runs on TrueForge",
  "version": "1.0.0",
  "publisher": "ledgerforge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aashwindev/ledgerforge"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ledgerforge.ask",
        "title": "LedgerForge: Ask Agent (open panel)"
      },
      {
        "command": "ledgerforge.inlineEdit",
        "title": "LedgerForge: Inline Edit Selection"
      },
      {
        "command": "ledgerforge.stop",
        "title": "LedgerForge: Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "ledgerforge.undo",
        "title": "LedgerForge: Undo Last Change"
      },
      {
        "command": "ledgerforge.undoRun",
        "title": "LedgerForge: Undo Last Run"
      },
      {
        "command": "ledgerforge.doctor",
        "title": "LedgerForge: Doctor"
      },
      {
        "command": "ledgerforge.acceptAll",
        "title": "LedgerForge: Accept All Hunks",
        "icon": "$(check-all)"
      },
      {
        "command": "ledgerforge.rejectAll",
        "title": "LedgerForge: Reject All Hunks",
        "icon": "$(close-all)"
      }
    ],
    "configurationDefaults": {
      "diffEditor.codeLens": true
    },
    "configuration": {
      "title": "LedgerForge",
      "properties": {
        "ledgerforge.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "TrueForge server URL (local mode)"
        },
        "ledgerforge.model": {
          "type": "string",
          "default": "openai/gpt-5-4-mini",
          "description": "Primary model, by its name in TrueForge Settings -> Models"
        },
        "ledgerforge.fallbackModel": {
          "type": "string",
          "default": "openai/gpt-5-4-nano",
          "description": "Second model TrueForge switches to automatically if the primary fails. Use a different provider so one bad key cannot take out both."
        },
        "ledgerforge.autoApproveCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "git status",
            "git diff",
            "git log",
            "git show"
          ],
          "description": "Command prefixes that run without asking (keep these read-only). Everything else the agent runs asks first."
        }
      }
    },
    "keybindings": [
      {
        "command": "ledgerforge.inlineEdit",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "ledgerforge.stop",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+."
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ledgerforge.acceptAll",
          "when": "resourceScheme == ledgerforge-proposal",
          "group": "navigation"
        },
        {
          "command": "ledgerforge.rejectAll",
          "when": "resourceScheme == ledgerforge-proposal",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "ledgerforge.acceptAll",
          "when": "ledgerforge.reviewing"
        },
        {
          "command": "ledgerforge.rejectAll",
          "when": "ledgerforge.reviewing"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ledgerforge",
          "title": "LedgerForge",
          "icon": "media/forge.svg"
        }
      ]
    },
    "views": {
      "ledgerforge": [
        {
          "type": "webview",
          "id": "ledgerforge.panel",
          "name": "Agent"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "watch": "npm run build -- --watch",
    "test": "esbuild test/unit.test.ts test/hunks.test.ts test/eligibility.test.ts test/safety.test.ts --bundle --platform=node --format=cjs --outdir=dist/test --log-level=warning && node --test dist/test/unit.test.js dist/test/hunks.test.js dist/test/eligibility.test.js dist/test/safety.test.js",
    "typecheck": "tsc -p . --noEmit",
    "bench": "esbuild scripts/bench-retrieval.ts --bundle --platform=node --outfile=dist/bench.js --log-level=warning && node dist/bench.js"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truefoundry/trueforge-sdk": "latest",
    "diff": "^5.2.2",
    "zod": "^3.25.76"
  }
}
